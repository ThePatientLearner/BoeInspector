# PLANTILLA PÚBLICA — este archivo SÍ se sube al repositorio.
# Nunca pongas aquí claves reales: cópialo a .env y rellénalo allí.
#   cp .env.example .env

# ── Base de datos (obligatoria: el monolito no arranca sin ella) ─
# Levántala con:  docker compose up -d db
# Las migraciones se aplican solas en el arranque.
DATABASE_URL=postgres://boe:boe@localhost:5432/boe_inspector

# ── IA (cualquier API compatible con el formato de OpenAI) ───────
# Cambiar de proveedor = cambiar estas tres variables, sin tocar código:
#   MiniMax  → https://api.minimax.io/v1        · MiniMax-M3
#   OpenAI   → https://api.openai.com/v1        · gpt-…
#   DeepSeek → https://api.deepseek.com/v1      · deepseek-chat
#   Ollama   → http://localhost:11434/v1        · llama3.1  (local, sin coste)
AI_BASE_URL=https://api.minimax.io/v1
AI_MODEL=MiniMax-M3
AI_API_KEY=

# ── Notificadores (opcionales: sin token, el canal se desactiva) ─
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=@boe_inspector
DISCORD_WEBHOOK_URL=

# ── Programación ─────────────────────────────────────────────────
# El BOE se publica L-S sobre las 07:30 Europe/Madrid
CRON_SCHEDULE="30 8 * * 1-6"
TZ=Europe/Madrid

# ── Servicio ─────────────────────────────────────────────────────
API_PORT=3001
# Dominio público de la web: se usa para componer los enlaces "resumen
# completo" de las notificaciones. En producción NUNCA localhost.
PUBLIC_WEB_URL=https://agenteboe.com
BOE_SECTIONS=1

# Segunda pasada: la IA revisa su propio resumen contra el texto oficial.
# Duplica el coste (céntimos) y corrige idioma, fidelidad y precisión.
AI_REVIEW=true
