{
  "name": "@boe-inspector/monolith",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "probe": "tsx --env-file-if-exists=../../.env src/cli/probe-latest.ts",
    "ingest": "tsx --env-file-if-exists=../../.env src/cli/run-ingestion.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:boundaries": "depcruise src",
    "db:generate": "drizzle-kit generate",
    "db:apply": "tsx --env-file-if-exists=../../.env src/cli/migrate-db.ts",
    "notify:test": "tsx --env-file-if-exists=../../.env src/cli/test-notifiers.ts",
    "serve": "tsx --env-file-if-exists=../../.env src/main.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.2.0",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "dependency-cruiser": "^16.9.0",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
